DATABASE_URL="postgresql://postgres:talha.1453@localhost:5432/tiktok_live_game?schema=public"

# Admin API access
ADMIN_SECRET="Ta.145357"

# Shopier callback HMAC secret from your Shopier API settings.
SHOPIER_API_SECRET="replace-with-shopier-api-secret"

# Optional Shopier product IDs and payment links (code defaults are used when omitted).
SHOPIER_PRODUCT_ID_WEEKLY="53114267"
SHOPIER_PRODUCT_ID_MONTHLY="53114277"
SHOPIER_PRODUCT_ID_LIFETIME="53114295"
SHOPIER_URL_WEEKLY="https://shopier.com/53114267"
SHOPIER_URL_MONTHLY="https://shopier.com/53114277"
SHOPIER_URL_LIFETIME="https://shopier.com/53114295"

# Optional one-day internal/test product; leave unset in production unless needed.
# SHOPIER_PRODUCT_ID_TEST=""

# Public package prices in TRY; amounts are fallback matching when product ID is absent.
SHOPIER_WEEKLY_AMOUNT="500"
SHOPIER_MONTHLY_AMOUNT="1000"
SHOPIER_LIFETIME_AMOUNT="2500"
# Shopier OSB (Sipariş Bildirim Ayarları) credentials used by /api/shopier/callback.
SHOPIER_OSB_USERNAME="your-shopier-osb-username"
SHOPIER_OSB_PASSWORD="your-shopier-osb-password"
