generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionStatus {
  trial
  active
  expired
}

enum LicensePlanType {
  SEVEN_DAYS  @map("7_DAYS")
  ONE_MONTH   @map("30_DAYS")
  LIFETIME
  TEST
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  tiktokUsername String        @unique
  overlayToken  String        @unique @default(uuid()) @db.Uuid
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subscription  Subscription?
}

model Subscription {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @unique @db.Uuid
  status    SubscriptionStatus @default(trial)
  expiresAt DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id])
}

model License {
  id            String          @id @default(uuid()) @db.Uuid
  licenseKey    String          @unique @default(uuid()) @db.Uuid
  overlayToken  String          @unique @default(uuid()) @db.Uuid
  customerName  String
  buyerEmail    String          @default("") @map("customerEmail")
  orderId       String          @unique
  planType      LicensePlanType
  startedAt     DateTime        @default(now())
  expiresAt     DateTime?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  shopierOrders ShopierOrder[]
}

model ShopierOrder {
  id        String          @id @default(uuid()) @db.Uuid
  orderId   String          @unique
  licenseId String          @db.Uuid
  planType  LicensePlanType
  createdAt DateTime        @default(now())
  license   License         @relation(fields: [licenseId], references: [id], onDelete: Cascade)
}
