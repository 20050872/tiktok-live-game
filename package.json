{
  "name": "tiktok-live-game-backend",
  "version": "1.0.0",
  "private": true,
  "description": "TikTokLiveGame için temel Node.js ve TypeScript backend altyapısı",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "npx prisma db push && node dist/server.js",
    "test": "npm run build && node --test",
    "prisma:generate": "prisma generate"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "socket.io-client": "^4.8.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "tiktok-live-connector": "^2.5.0"
  }
}
